PROGRAM My_Program
VAR
  PUMP_CMD AT %QX0.0 : BOOL;
  VALVE_CMD AT %QX0.1 : BOOL;
  ALARM_HI_ACTIVE AT %QX0.2 : BOOL;
  ALARM_LO_ACTIVE AT %QX0.3 : BOOL;

  PUMP_FLOW_SP AT %QW1 : INT;
  VALVE_FLOW_SP AT %QW2 : INT;
  ALARM_HI_SP AT %QW3 : INT;
  ALARM_LO_SP AT %QW4 : INT;
  LEVEL_AI AT %QW6 : INT;
END_VAR

VAR
  INIT_DONE : BOOL;
  INFLOW : INT;
  OUTFLOW : INT;
  DELTA : INT;
  CYCLE_CNT : INT;
END_VAR

IF NOT INIT_DONE THEN
  PUMP_FLOW_SP := 0;
  VALVE_FLOW_SP := 0;
  ALARM_HI_SP := 0;
  ALARM_LO_SP := 0;
  IF LEVEL_AI < 0 THEN LEVEL_AI := 0; END_IF;
  INIT_DONE := TRUE;
END_IF;

IF PUMP_FLOW_SP < 0 THEN PUMP_FLOW_SP := 0; END_IF;
IF PUMP_FLOW_SP > 100 THEN PUMP_FLOW_SP := 100; END_IF;

IF VALVE_FLOW_SP < 0 THEN VALVE_FLOW_SP := 0; END_IF;
IF VALVE_FLOW_SP > 100 THEN VALVE_FLOW_SP := 100; END_IF;

IF ALARM_HI_SP < 0 THEN ALARM_HI_SP := 0; END_IF;
IF ALARM_HI_SP > 100 THEN ALARM_HI_SP := 100; END_IF;

IF ALARM_LO_SP < 0 THEN ALARM_LO_SP := 0; END_IF;
IF ALARM_LO_SP > 100 THEN ALARM_LO_SP := 100; END_IF;

CYCLE_CNT := CYCLE_CNT + 1;
IF CYCLE_CNT >= 10 THEN
  CYCLE_CNT := 0;

  IF PUMP_CMD AND (PUMP_FLOW_SP > 0) THEN
    INFLOW := (PUMP_FLOW_SP + 24) / 25;
  ELSE
    INFLOW := 0;
  END_IF;

  IF VALVE_CMD AND (VALVE_FLOW_SP > 0) THEN
    OUTFLOW := (VALVE_FLOW_SP + 24) / 25;
  ELSE
    OUTFLOW := 0;
  END_IF;

  DELTA := INFLOW - OUTFLOW;
  LEVEL_AI := LEVEL_AI + DELTA;

  IF LEVEL_AI < 0 THEN LEVEL_AI := 0; END_IF;
  IF LEVEL_AI > 100 THEN LEVEL_AI := 100; END_IF;
END_IF;

IF ALARM_HI_SP > 0 THEN
  ALARM_HI_ACTIVE := LEVEL_AI >= ALARM_HI_SP;
ELSE
  ALARM_HI_ACTIVE := FALSE;
END_IF;

IF ALARM_LO_SP > 0 THEN
  ALARM_LO_ACTIVE := LEVEL_AI <= ALARM_LO_SP;
ELSE
  ALARM_LO_ACTIVE := FALSE;
END_IF;

END_PROGRAM

CONFIGURATION Config0
  RESOURCE Res0 ON PLC
    TASK TaskMain(INTERVAL := T#100ms, PRIORITY := 0);
    PROGRAM Inst0 WITH TaskMain : My_Program;
  END_RESOURCE
END_CONFIGURATION

